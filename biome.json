{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "**",
      "!**/.agents",
      "!**/node_modules",
      "!**/lib",
      "!**/browser",
      "!**/benchmark",
      "!**/coverage-reports",
      "!**/test/__snapshots__"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "all",
      "nursery": "on",
      "complexity": {
        "noExcessiveCognitiveComplexity": "off",
        "noExcessiveLinesPerFunction": "off",
        "useMaxParams": "off",
        "noAdjacentSpacesInRegex": "error",
        "noArguments": "error",
        "noBannedTypes": "error",
        "noCommaOperator": "error",
        "noEmptyTypeParameters": "error",
        "noExcessiveNestedTestSuites": "error",
        "noExtraBooleanCast": "error",
        "noFlatMapIdentity": "error",
        "noForEach": "error",
        "noStaticOnlyClass": "error",
        "noThisInStatic": "error",
        "noUselessCatch": "error",
        "noUselessConstructor": "error",
        "noUselessContinue": "error",
        "noUselessEmptyExport": "error",
        "noUselessEscapeInRegex": "error",
        "noUselessFragments": "error",
        "noUselessLabel": "error",
        "noUselessLoneBlockStatements": "error",
        "noUselessRename": "error",
        "noUselessSwitchCase": "error",
        "noUselessTernary": "error",
        "noUselessThisAlias": "error",
        "noUselessTypeConstraint": "error",
        "useArrowFunction": "error",
        "useFlatMap": "error",
        "useLiteralKeys": "error",
        "useNumericLiterals": "error",
        "useOptionalChain": "error",
        "useRegexLiterals": "error",
        "useSimpleNumberKeys": "error",
        "useWhile": "error"
      },
      "correctness": {
        "noNodejsModules": "off",
        "usePlaywrightValidDescribeCallback": "off",
        "useQwikValidLexicalScope": "off",
        "useImportExtensions": {
          "level": "error",
          "options": {
            "forceJsExtensions": true
          }
        },
        "noUnusedLabels": "error"
      },
      "performance": {
        "noAccumulatingSpread": "error",
        "noBarrelFile": "error",
        "noDelete": "error",
        "noReExportAll": "error",
        "noNamespaceImport": "off"
      },
      "security": {
        "noSecrets": "off"
      },
      "suspicious": {
        "noEmptyBlockStatements": "off",
        "noConsole": "off",
        "noControlCharactersInRegex": "off",
        "useExpect": "off",
        "noApproximativeNumericConstant": "error",
        "noCatchAssign": "error",
        "noConfusingLabels": "error",
        "noConfusingVoidType": "error",
        "noConstEnum": "error",
        "noDuplicateFields": "error",
        "noEmptyBlock": "error",
        "noExplicitAny": "error",
        "noExtraNonNullAssertion": "error",
        "noFocusedTests": "error",
        "noGlobalIsFinite": "error",
        "noGlobalIsNan": "error",
        "noPrototypeBuiltins": "error",
        "noRedundantUseStrict": "error",
        "noSuspiciousSemicolonInJsx": "error",
        "noVar": "error",
        "useDefaultSwitchClauseLast": "error",
        "useIsArray": "error",
        "useStrictMode": "error"
      },
      "style": {
        "useNamingConvention": "off",
        "noDefaultExport": "error",
        "useBlockStatements": "off",
        "noNonNullAssertion": "off",
        "noNestedTernary": "off",
        "noCommonJs": "off",
        "noContinue": "off",
        "noExcessiveLinesPerFile": "off",
        "noIncrementDecrement": "off",
        "noMagicNumbers": "off",
        "noTernary": "off",
        "useExportsLast": "off",
        "useUnicodeRegex": "off",
        "useConsistentTypeDefinitions": {
          "level": "on",
          "options": {
            "style": "type"
          }
        },
        "useNumericSeparators": {
          "level": "on",
          "options": {
            "hexadecimal": {
              "groupLength": 4
            }
          }
        },
        "noDescendingSpecificity": "error",
        "noInferrableTypes": "error",
        "noParameterAssign": "error",
        "noUnusedTemplateLiteral": "error",
        "noUselessElse": "error",
        "useAsConstAssertion": "error",
        "useConsistentMemberAccessibility": "error",
        "useConst": "error",
        "useDefaultParameterLast": "error",
        "useDeprecatedReason": "error",
        "useEnumInitializers": "error",
        "useExponentiationOperator": "error",
        "useExportType": "error",
        "useImportType": "error",
        "useLiteralEnumMembers": "error",
        "useNodejsImportProtocol": "error",
        "useNumberNamespace": "error",
        "useSelfClosingElements": "error",
        "useShorthandFunctionType": "error",
        "useSingleVarDeclarator": "error",
        "useTemplate": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**"],
      "linter": {
        "rules": {
          "nursery": {
            "useExplicitType": "off",
            "useExplicitReturnType": "off",
            "noExcessiveStatementsPerFunction": "off",
            "noMisleadingReturnType": "off",
            "noNestedTemplateLiterals": "off",
            "noNull": "off",
            "noYamlEmptyMapValues": "off",
            "useConsistentBooleanName": "off",
            "useLowercaseTestTitle": "off",
            "usePackageJsonCpu": "off"
          }
        }
      }
    },
    {
      "includes": ["**/test/**", "**/tools/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "off",
            "useImportExtensions": {
              "level": "error",
              "options": {
                "forceJsExtensions": false
              }
            }
          },
          "performance": {
            "useTopLevelRegex": "off",
            "noAwaitInLoops": "off"
          },
          "nursery": {
            "noExtendNative": "off",
            "noSyncMethods": {
              "level": "on",
              "options": {
                "ignore": ["readFileSync"]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/src/index.ts"],
      "linter": {
        "rules": {
          "nursery": {
            "noUnsafeTypeAssertion": "off"
          }
        }
      }
    },
    {
      "includes": ["**/mcr.config.ts"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    }
  ]
}
